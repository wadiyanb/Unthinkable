// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  RESIDENT
  ADMIN
}

enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum Category {
  PLUMBING
  ELECTRICAL
  LIFT_ELEVATOR
  CLEANING
  SECURITY
  WATER_SUPPLY
  PARKING
  COMMON_AREA
  OTHER
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(RESIDENT)
  flatNumber   String?
  phone        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  complaints       Complaint[]       @relation("ResidentComplaints")
  historyActions   ComplaintHistory[] @relation("ActorHistory")
  noticesCreated   Notice[]          @relation("NoticeCreator")

  @@index([email])
  @@index([role])
}

model Complaint {
  id         String          @id @default(cuid())
  title      String
  description String
  category   Category
  status     ComplaintStatus @default(OPEN)
  priority   Priority        @default(MEDIUM)
  photoUrl   String?
  residentId String
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  resolvedAt DateTime?

  resident User               @relation("ResidentComplaints", fields: [residentId], references: [id], onDelete: Cascade)
  history  ComplaintHistory[]

  @@index([residentId])
  @@index([status])
  @@index([category])
  @@index([priority])
  @@index([createdAt])
  @@index([status, createdAt])
}

model ComplaintHistory {
  id             String          @id @default(cuid())
  complaintId    String
  previousStatus ComplaintStatus?
  newStatus      ComplaintStatus
  note           String?
  actorId        String
  createdAt      DateTime        @default(now())

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  actor     User      @relation("ActorHistory", fields: [actorId], references: [id])

  @@index([complaintId])
  @@index([createdAt])
}

model Notice {
  id          String   @id @default(cuid())
  title       String
  content     String
  isImportant Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String

  createdBy User @relation("NoticeCreator", fields: [createdById], references: [id])

  @@index([isImportant])
  @@index([createdAt])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
}
